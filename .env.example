# Free local chatbot. The model must already be available in Ollama:
# ollama pull qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=35

# Optional local image verification. Install a vision-capable Ollama model first:
# ollama pull qwen3-vl:2b   (smaller and faster; qwen2.5vl:3b also works)
# Without this, uploaded photos are kept but are explicitly marked unverified,
# and a certificate cannot be issued.
OLLAMA_VISION_MODEL=

# Free browser speech is the default. Browser voice availability varies by device.
# Set to "edge" only to opt into the unofficial internet-dependent edge-tts service.
DAFTER_TTS_MODE=browser
DAFTER_TTS_VOICE=ar-TN-ReemNeural
DAFTER_TTS_RATE=-10%

# Optional local speech recognition: install faster-whisper to enable server STT.
DAFTER_WHISPER_MODEL=small

# Optional paid APIs; neither is needed for Ollama + browser speech.
ANTHROPIC_API_KEY=
DAFTER_LLM_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=

# Dafter creates and stores a random signing secret in this file the first time
# a certificate is requested if this is left blank. Keep the file private.
DAFTER_SECRET=
DAFTER_BASE_URL=http://127.0.0.1:8000

# Optional database path. Defaults to dafter.db in the project working directory.
# DAFTER_DB=
